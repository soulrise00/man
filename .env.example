# Copy to `.env` and adjust. Every value has a sensible default.

# --- Engine ---------------------------------------------------------------
# Default model. CPU sweet-spot = isnet-general-use. Use birefnet-general on GPU.
# NOTE: isnet-general-use / birefnet-general weights are MIT (commercial OK).
#       Do NOT switch to bria-rmbg / u2net-human-seg on a paid platform —
#       those weights are non-commercial. See README "License".
REMBG_MODEL=isnet-general-use

# Comma-separated extra models to pre-load at startup.
REMBG_PRELOAD=

# Max simultaneous inferences (protects RAM; BiRefNet can spike to ~9GB).
MAX_CONCURRENCY=2

# Threads per inference (0 = auto). Also set OMP_NUM_THREADS to match.
ONNX_THREADS=0
OMP_NUM_THREADS=4

# Refine fuzzy edges (hair/fur). Slower; off by default for product shots.
ALPHA_MATTING=false

# --- Outputs --------------------------------------------------------------
MAX_OUTPUT_PX=2000          # cap longest side (0 = keep original)
THUMBNAIL_PX=400
FLAT_BACKGROUND=255,255,255 # background for the composited JPG (marketplace white)
JPEG_QUALITY=90
MAX_UPLOAD_MB=25

# --- Storage --------------------------------------------------------------
STORAGE_BACKEND=local       # local | s3
PUBLIC_BASE_URL=http://localhost:8000

# S3 / MinIO / R2 (only when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_PREFIX=nukki
S3_REGION=
S3_ENDPOINT_URL=            # set for MinIO/R2
S3_PUBLIC_BASE_URL=         # CDN or bucket public base

# --- Database -------------------------------------------------------------
# Empty => SQLite at $DATA_DIR/app.db. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/nukki
DATABASE_URL=

# --- Misc -----------------------------------------------------------------
DATA_DIR=data
